{
  "name": "dark-dragon-assets",
  "version": "3.0.0",
  "description": "Autonomous game tile generation (5 tilesets/day Mon-Fri) and weekly itch.io publishing via butler",
  "type": "module",
  "main": "src/generate-daily.mjs",
  "scripts": {
    "generate:daily": "node src/generate-daily.mjs",
    "bundle:weekly": "node src/bundle-weekly.mjs",
    "publish:weekly": "node src/publish-itchio.mjs",
    "test:pipeline": "node scripts/test-pipeline.mjs"
  },
  "keywords": [
    "game-assets",
    "tiles",
    "tileset",
    "itch.io",
    "automation"
  ],
