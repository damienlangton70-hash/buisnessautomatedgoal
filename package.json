{
  "name": "dark-dragon-assets",
  "version": "2.0.0",
  "description": "Autonomous game tile generation (5 tilesets/day M-F) and weekly itch.io publishing",
  "type": "module",
  "main": "src/generate-daily.mjs",
  "scripts": {
    "generate:daily": "node src/generate-daily.mjs",
    "bundle:weekly": "node src/bundle-weekly.mjs",
    "generate:test": "TEST_MODE=true node src/generate-daily.mjs",
    "bundle:test": "TEST_MODE=true node src/bundle-weekly.mjs"
  },
  "keywords": [
    "game-assets",
    "tiles",
    "itch.io",
    "automation"
  ],
  "author": "Damien Langton",
  "license": "MIT",
  "dependencies": {
    "openai": "^4.24.0",
    "jimp": "^0.22.10",
    "archiver": "^6.0.0"
  },
  "devDependencies": {}
}
