# --- Image generation ---
# Which provider generates the art. "fal" is the default and the recommended
# one: FLUX 2 pro, ~$0.03/image, and visibly better on game art than DALL-E 3.
IMAGE_PROVIDER=fal        # fal | bfl | openai

# fal.ai  -> https://fal.ai/dashboard/keys       (IMAGE_PROVIDER=fal)
FAL_KEY=your-fal-key-here

# Black Forest Labs direct -> https://dashboard.bfl.ai  (IMAGE_PROVIDER=bfl)
BFL_API_KEY=

# OpenAI DALL-E 3 fallback -> https://platform.openai.com/api-keys
OPENAI_API_KEY=
IMAGE_QUALITY=hd          # openai only: hd ($0.08/image) or standard ($0.04)

# --- itch.io publishing (via butler; itch.io has no HTTP upload API) ---
BUTLER_API_KEY=your-itch-io-api-key-here
ITCHIO_USERNAME=your-itch-io-username
# The URL slug, e.g. "weekly-asset-pack" from https://you.itch.io/weekly-asset-pack
# NOT the numeric game ID, and NOT your email address — butler addresses games
# by slug.
ITCHIO_GAME_SLUG=weekly-asset-pack

# --- Optional tuning ---
TILESETS_PER_RUN=5
TILE_SIZE=512
WEEK_ID=                  # override the ISO week for bundle/publish, e.g. 2026-36
DATA_DIR=                 # override where working assets live
DIST_DIR=                 # override where packs are staged

# --- Testing ---
TEST_MODE=false           # true = synthesise placeholder tiles locally, no API calls
DRY_RUN=false             # true = stage the pack but skip the butler push
# ALLOW_PLACEHOLDERS      # test suite only. Never set this in production: it
#                         # disables the guard that stops placeholder art being
#                         # bundled into a pack a customer pays for.
